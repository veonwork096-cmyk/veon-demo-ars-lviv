---
import { asset } from "../data/asset";
import FutureLink from "./FutureLink.astro";
import { phone, legalName, SOON } from "../data/ars";
const pages = ["Доставка", "Оплата", "Гарантія та повернення", "Договір оферти", "Політика конфіденційності"];
---
<footer class="ftr">
  <div class="container ftr__grid">
    <div class="ftr__brand">
      <a class="ftr__logo" href="#top" aria-label="АРС, на початок сторінки"><img src={asset("logo-ars.svg")} width="114" height="36" alt="АРС" /></a>
      <p class="caption">{legalName}</p>
    </div>
    <nav class="ftr__nav" aria-label="Інформація для покупців">
      <ul>
        <li><a href="#about">Про АРС</a></li>
        {pages.map((p) => <li><FutureLink note={SOON}>{p}</FutureLink></li>)}
      </ul>
    </nav>
    <p class="ftr__phone"><a class="num" href={phone.href}>{phone.label}</a></p>
  </div>
</footer>

<style>
  .ftr { background: var(--color-bg); border-top: 1px solid var(--color-rule); padding-block: var(--s-6) var(--s-6); }
  .ftr__grid { display: grid; gap: var(--s-5); }
  .ftr__brand { display: grid; gap: var(--s-3); justify-items: start; }
  .ftr__logo { display: inline-flex; min-height: var(--hit); align-items: center; }
  .ftr__logo img { width: 92px; }
  .ftr__nav ul { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-5); font-size: var(--fs-0); }
  .ftr__nav li { display: flex; align-items: center; min-height: 2.75rem; }
  .ftr__phone { font-weight: 600; font-size: var(--fs-2); }
  .ftr__phone a { display: inline-flex; align-items: center; min-height: var(--hit); }
  @media (min-width: 64rem) {
    .ftr__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); align-items: start; }
    .ftr__brand { grid-column: 1 / span 3; }
    .ftr__nav { grid-column: 4 / span 7; }
    .ftr__phone { grid-column: 11 / span 2; justify-self: end; }
  }
  /* room for the mobile contact bar */
  @media (max-width: 47.99rem) { .ftr { padding-bottom: calc(var(--s-6) + 4.5rem); } }
</style>

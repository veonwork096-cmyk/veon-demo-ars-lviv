---
// Line service icons, 24px grid, one stroke style (paths after Feather, MIT). Decorative: labels carry the meaning.
type Name = "phone" | "viber" | "telegram" | "mail" | "menu" | "close" | "down" | "right";
interface Props { name: Name; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />}
  {name === "viber" && <><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z" /><path d="M12.5 7.5a4 4 0 0 1 4 4" /><path d="M12.5 10a1.5 1.5 0 0 1 1.5 1.5" /></>}
  {name === "telegram" && <><path d="M22 2 11 13" /><path d="M22 2 15 22l-4-9-9-4z" /></>}
  {name === "mail" && <><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></>}
  {name === "menu" && <><path d="M3 7h18" /><path d="M3 12h18" /><path d="M3 17h18" /></>}
  {name === "close" && <><path d="M18 6 6 18" /><path d="M6 6l12 12" /></>}
  {name === "down" && <><path d="M12 5v14" /><path d="m19 12-7 7-7-7" /></>}
  {name === "right" && <><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></>}
</svg>
